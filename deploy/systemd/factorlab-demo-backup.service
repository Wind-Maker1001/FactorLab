[Unit]
Description=FactorLab Binance Demo coherent backup and retention (NO LIVE MONEY)
After=local-fs.target
# Let C06 classify the restart using the committed backup status.
Before=factorlab-demo-health.service factorlab-demo-daily-report.service
RequiresMountsFor=/var/lib/factorlab-demo/execute-state /var/backups/factorlab-demo

[Service]
Type=oneshot
WorkingDirectory=/opt/factorlab
Environment=PYTHONUNBUFFERED=1
Environment=FACTORLAB_DEMO_STATE_ROOT=/var/lib/factorlab-demo/execute-state
Environment=FACTORLAB_DEMO_BACKUP_ROOT=/var/backups/factorlab-demo
Environment=FACTORLAB_DEMO_BACKUP_RETENTION_DAYS=14
Environment=FACTORLAB_DEMO_BACKUP_MIN_VALID_COPIES=1
RuntimeDirectory=factorlab-demo-backup
RuntimeDirectoryMode=0700
ExecStart=/opt/factorlab/venv/bin/python -m factorlab.integrations.binance_futures_trading.demo_cloud_backup run-scheduled --state-root ${FACTORLAB_DEMO_STATE_ROOT} --backup-root ${FACTORLAB_DEMO_BACKUP_ROOT} --retention-days ${FACTORLAB_DEMO_BACKUP_RETENTION_DAYS} --min-valid-copies ${FACTORLAB_DEMO_BACKUP_MIN_VALID_COPIES} --recovery-directory ${RUNTIME_DIRECTORY}
ExecStopPost=/opt/factorlab/venv/bin/python -m factorlab.integrations.binance_futures_trading.demo_cloud_backup recover-scheduled --state-root ${FACTORLAB_DEMO_STATE_ROOT} --backup-root ${FACTORLAB_DEMO_BACKUP_ROOT} --recovery-directory ${RUNTIME_DIRECTORY}
# Bound the whole workflow and give the separate stop hook its own budget.
TimeoutStartSec=20min
TimeoutStartFailureMode=abort
WatchdogSignal=SIGTERM
TimeoutAbortSec=15s
TimeoutStopSec=6min
KillMode=control-group
UMask=0077
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
InaccessiblePaths=/etc/factorlab-demo
ReadWritePaths=/var/lib/factorlab-demo/execute-state /var/backups/factorlab-demo
