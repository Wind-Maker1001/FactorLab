[Unit]
Description=FactorLab Alpaca Paper health
After=factorlab-alpaca-paper.service

[Service]
Type=oneshot
User=factorlab-alpaca
Group=factorlab-alpaca
ExecStart=/opt/factorlab-alpaca/current/venv/bin/python -m factorlab.integrations.alpaca.cloud_runtime health
ExecStopPost=/opt/factorlab-alpaca/current/venv/bin/python /opt/factorlab-alpaca/current/source/tools/evidence/runtime_capacity.py snapshot --alpaca --monitor-dir /var/lib/factorlab-alpaca-paper/monitoring
StateDirectory=factorlab-alpaca-paper/monitoring
StateDirectoryMode=0700
ReadWritePaths=/var/lib/factorlab-alpaca-paper/monitoring
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
